# 复制到 /etc/wenxin/aliyun-moderation.env，权限必须为 root:root 0600。
# 密钥只填写在服务器文件中，不要提交到 Git，也不要发送到聊天。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_MODERATION_ENDPOINT=green-cip.cn-shanghai.aliyuncs.com
ALIYUN_MODERATION_ENABLED=false

# 只有输入/输出审核验收全部通过后，才能与上一项同时改为 true。
AI_RISK_CONTROL_READY=false
