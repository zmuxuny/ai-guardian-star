# Install as /etc/wenxin/board-face.env with mode 600.
# This loopback port must be the trusted FRP tunnel to the board HTTP service.
BOARD_FACE_BASE_URL=http://127.0.0.1:6001
# Must equal AI_GUARDIAN_FACE_ADMIN_TOKEN on the board. Never put it in the App or Git.
BOARD_FACE_ADMIN_TOKEN=replace-with-a-random-long-token
